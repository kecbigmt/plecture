#!/usr/bin/env sh
# comm: the pane's found child reports itself as the agent CLI. ppid:
# answers whether a self-reported pid is really the pane's child, using
# PLECT_EFFECT_PID as the pane's own identity so an unrelated pid can be
# told apart from a real one.
plect-effect-record ps "$@"
target=""
prev=""
for arg in "$@"; do
  [ "$prev" = "-p" ] && target="$arg"
  prev="$arg"
done
case "$*" in
  *ppid=*)
    # The stand-in pane process cannot be a real parent.
    if [ "$target" = "$PLECT_EFFECT_WORKER_PID" ] || { [ -n "${PLECT_EFFECT_REAL_WORKER:-}" ] && PATH=$(printf '%s' "$PATH" | sed 's|^'"$PLECT_EFFECT_BIN"':||') ps -o args= -p "$target" 2>/dev/null | grep -q -- '-worker'; }; then
      printf '%s\n' "$PLECT_EFFECT_PID"
    else
      printf '%s\n' "1"
    fi
    ;;
  *lstart=*)
    printf '%s\n' "started-$target"
    ;;
  *)
    printf '%s\n' "claude"
    ;;
esac
