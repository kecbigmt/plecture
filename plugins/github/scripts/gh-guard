#!/usr/bin/env bash
# gh guard shim: mechanically denies merge/close so an agent session can't
# act on a forgotten or de-prioritized "don't merge" instruction. Threat
# model is forgetting, not evasion — bypassing by invoking the real `gh`
# directly (its resolved absolute path) is out of scope.
#
# A task's setup script symlinks this file as `gh` inside a shim directory
# it prepends to PATH, only for sessions that opt in via the task's
# `gh_guard` input. GH_GUARD_REAL_GH must be the real gh's absolute path,
# resolved by the setup script *before* the shim directory is prepended to
# PATH — a bare `gh` lookup here would resolve back to this same shim (the
# shim directory is still ahead of it on PATH) and recurse forever, so a
# GH_GUARD_REAL_GH that resolves back to this file is treated as a
# misconfiguration and rejected rather than silently falling back to some
# assumed install path (this plugin ships to unknown hosts, so it has no
# such path to assume).
#
# The deny check itself lives in gh-guard-lib.sh, shared with gh-app-guard
# — see that file for why it is sourced rather than a second wrapper hop.
set -euo pipefail

: "${GH_GUARD_REAL_GH:?gh-guard: GH_GUARD_REAL_GH must point at the real gh binary}"
if [ "$(readlink -f "$GH_GUARD_REAL_GH")" = "$(readlink -f "$0")" ]; then
  echo "gh-guard: GH_GUARD_REAL_GH=$GH_GUARD_REAL_GH resolves back to this shim; refusing to recurse" >&2
  exit 1
fi
[ -x "$GH_GUARD_REAL_GH" ] || {
  echo "gh-guard: GH_GUARD_REAL_GH=$GH_GUARD_REAL_GH is not executable" >&2
  exit 1
}

lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=gh-guard-lib.sh
. "$lib_dir/gh-guard-lib.sh"
trap 'rm -f "$GH_GUARD_STDIN_CAPTURE"' EXIT

if gh_guard_check_denied "$@"; then
  gh_guard_deny
fi

if [ -n "$GH_GUARD_STDIN_CAPTURE" ]; then
  # Open the buffered body on a separate fd, then unlink it immediately: the
  # inode stays reachable through that fd across exec (so the real gh still
  # reads the full body on its stdin), but no temp file survives on disk once
  # the replaced process closes it — exec never runs this script's own EXIT
  # trap, so without this the file would otherwise leak on every guarded
  # `--input -` call.
  exec 3< "$GH_GUARD_STDIN_CAPTURE"
  rm -f "$GH_GUARD_STDIN_CAPTURE"
  exec "$GH_GUARD_REAL_GH" "$@" <&3
fi

exec "$GH_GUARD_REAL_GH" "$@"
