#!/usr/bin/env sh
# Names the scratch directory after the caller's own template instead of
# randomizing it, so the recorded paths are stable.
plect-effect-record mktemp "$@"
template=""
dir=""
for arg in "$@"; do
  case "$arg" in
    -d) dir=1 ;;
    -*) ;;
    *) template="$arg" ;;
  esac
done
name=$(basename "${template:-plect.XXXXXX}" | sed 's/\.*X*$//')
path="$PLECT_EFFECT_STATE/$name"
if [ -n "$dir" ]; then mkdir -p "$path"; else : > "$path"; fi
printf '%s\n' "$path"
