#!/usr/bin/env bash
# Serializes the exec_runtime task's mcp_servers parameter into Codex config
# overrides: the records arrive in CODEX_MCP_SERVERS, and a JSON array of
# `-c` values — one `mcp_servers.<name>={...}` per record — leaves on stdout.
#
# The records reach jq through $ENV rather than argv, so a credential in a
# record's `env` is not readable from this process's own command line.
#
# Each record replaces its whole `mcp_servers.<name>` table rather than
# setting command/args/env as separate keys: separate keys would merge into a
# same-named server from the user's own Codex config, keeping fields such as
# a `url` that contradict the declared command.
#
# A malformed record fails the launch rather than being dropped: a silently
# missing registration surfaces much later, as a tool the agent cannot find.

set -euo pipefail

if [ -z "${CODEX_MCP_SERVERS:-}" ]; then
  echo '[]'
  exit 0
fi

jq -nc '
  def known: ["name", "command", "args", "env"];
  def name_of($i; $rec):
    if ($rec | type) == "object" and ($rec.name | type) == "string" and $rec.name != ""
    then "\"\($rec.name)\""
    else "at index \($i)"
    end;
  def fail($i; $rec; $msg):
    error("mcp_servers record \(name_of($i; $rec)) \($msg)");
  # A JSON string literal is also a TOML basic string: jq escapes every
  # control character TOML forbids raw, and never emits the one JSON escape
  # TOML lacks.
  def toml_table:
    "{" + (to_entries | map("\(.key | tojson) = \(.value | tojson)") | join(", ")) + "}";

  ($ENV.CODEX_MCP_SERVERS
   | (try fromjson catch error("mcp_servers is not valid JSON"))
   | if type == "array" then .
     else error("mcp_servers must be a JSON array of server records")
     end) as $recs
  | reduce range(0; $recs | length) as $i ({seen: {}, out: []};
      $recs[$i] as $rec
      | if ($rec | type) != "object" then
          fail($i; $rec; "is not an object")
        elif ($rec | has("name") | not) then
          fail($i; $rec; "is missing required field \"name\"")
        elif ($rec.name | type) != "string" or $rec.name == "" then
          fail($i; $rec; "field \"name\" must be a non-empty string")
        elif ($rec.name | test("^[A-Za-z0-9_-]+$") | not) then
          fail($i; $rec; "field \"name\" must contain only letters, digits, \"_\", and \"-\"")
        elif ($rec | has("command") | not) then
          fail($i; $rec; "is missing required field \"command\"")
        elif ($rec.command | type) != "string" or $rec.command == "" then
          fail($i; $rec; "field \"command\" must be a non-empty string")
        elif (($rec | keys) - known) != [] then
          fail($i; $rec; "declares unsupported field \"\((($rec | keys) - known)[0])\"")
        elif ($rec | has("args"))
             and (($rec.args | type) != "array"
                  or ([$rec.args[] | select(type != "string")] | length) > 0) then
          fail($i; $rec; "field \"args\" must be an array of strings")
        elif ($rec | has("env"))
             and (($rec.env | type) != "object"
                  or ([$rec.env[] | select(type != "string")] | length) > 0) then
          fail($i; $rec; "field \"env\" must be an object of strings")
        elif (.seen | has($rec.name)) then
          fail($i; $rec; "repeats a name an earlier record already registered")
        else
          .seen[$rec.name] = true
          | .out += ["mcp_servers.\($rec.name)={"
              + ((["command = \($rec.command | tojson)"]
                  + (if $rec | has("args") then ["args = \($rec.args | tojson)"] else [] end)
                  + (if $rec | has("env") then ["env = \($rec.env | toml_table)"] else [] end))
                 | join(", "))
              + "}"]
        end)
  | .out
'
