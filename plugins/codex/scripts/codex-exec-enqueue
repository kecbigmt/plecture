#!/usr/bin/env bash
# codex-headless runtime channel: append one instruction to a session's
# queue directory (consumed by codex-exec-worker). Enqueue only writes
# a file and returns — it must never block on the turn itself, since it runs
# inside the dispatcher's exec channel and shares its delivery timeout.
#
# Usage: codex-exec-enqueue <queue_dir> <envelope> <type> <body> <summary> <url>

set -euo pipefail

queue_dir="${1:?queue_dir required}"
envelope="${2:?envelope required}"
event_type="${3:?event_type required}"
body="${4-}"
summary="${5-}"
url="${6-}"

# The envelope is the channel's `message_envelope` parameter: a user-supplied
# format string expanded here, against exactly the fields the channel passes
# in. Substitution is bash parameter replacement, never eval — the envelope
# chooses the message's shape, and nothing else.
body_or_summary="$body"
[ -n "$body_or_summary" ] || body_or_summary="$summary"
url_suffix=""
[ -n "$url" ] && url_suffix=" ($url)"

text="$envelope"
text="${text//\{type\}/$event_type}"
text="${text//\{body_or_summary\}/$body_or_summary}"
text="${text//\{body\}/$body}"
text="${text//\{summary\}/$summary}"
text="${text//\{url_suffix\}/$url_suffix}"
text="${text//\{url\}/$url}"

mkdir -p "$queue_dir"

tmp="$(mktemp "$queue_dir/.enqueue.XXXXXX")"
jq -n --arg type "$event_type" --arg text "$text" --arg url "$url" \
  '{type: $type, text: $text, url: $url}' > "$tmp"

# A github.* notification is a snapshot of a resource's state, so an unconsumed
# one for the same (type, url) is stale the moment a newer one arrives and
# would only cost the agent a wasted turn. Other types (user.emit above all)
# are instructions, not snapshots, and are never dropped. A file with no url
# key predates this rule and an empty url identifies no resource; neither is
# ever coalesced.
if [[ "$event_type" == github.* && -n "$url" ]]; then
  for old in "$queue_dir"/*.json; do
    [ -e "$old" ] || continue
    if jq -e --arg type "$event_type" --arg url "$url" \
      'has("url") and .type == $type and .url == $url' "$old" > /dev/null 2>&1; then
      rm -f "$old"
    fi
  done
fi

mv "$tmp" "$queue_dir/$(date +%s%N)-$$.json"
