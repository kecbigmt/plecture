#!/usr/bin/env bash
# gh guard shim: mechanically denies merge/close so an agent session can't
# act on a forgotten or de-prioritized "don't merge" instruction. Threat
# model is forgetting, not evasion — bypassing by invoking the real `gh`
# directly (its resolved absolute path) is out of scope.
#
# A task's setup script symlinks this file as `gh` inside a shim directory
# it prepends to PATH, only for sessions that opt in via the task's
# `gh_guard` input. GH_GUARD_REAL_GH must be the real gh's absolute path,
# resolved by the setup script *before* the shim directory is prepended to
# PATH — a bare `gh` lookup here would resolve back to this same shim (the
# shim directory is still ahead of it on PATH) and recurse forever, so a
# GH_GUARD_REAL_GH that resolves back to this file is treated as a
# misconfiguration and rejected rather than silently falling back to some
# assumed install path (this plugin ships to unknown hosts, so it has no
# such path to assume).
set -euo pipefail

: "${GH_GUARD_REAL_GH:?gh-guard: GH_GUARD_REAL_GH must point at the real gh binary}"
if [ "$(readlink -f "$GH_GUARD_REAL_GH")" = "$(readlink -f "$0")" ]; then
  echo "gh-guard: GH_GUARD_REAL_GH=$GH_GUARD_REAL_GH resolves back to this shim; refusing to recurse" >&2
  exit 1
fi
[ -x "$GH_GUARD_REAL_GH" ] || {
  echo "gh-guard: GH_GUARD_REAL_GH=$GH_GUARD_REAL_GH is not executable" >&2
  exit 1
}

# Set once a `gh api --input -` body has been buffered off real stdin (see
# below) so it can be replayed to the real gh after this shim itself has
# finished reading stdin to inspect it. Declared here, before deny() can
# exit, so the EXIT trap below always sees a defined (possibly empty) value.
stdin_capture=""
trap 'rm -f "$stdin_capture"' EXIT

deny() {
  echo "This session does not merge/close. Record your result (verdict / PR ready state); merging is the orchestrator's job." >&2
  exit 1
}

sub="${1:-}"
action="${2:-}"

case "$sub $action" in
  "pr merge" | "issue close" | "pr close")
    deny
    ;;
esac

if [ "$sub" = "api" ]; then
  method="GET"
  path=""
  body_has_closed=0
  input_value=""
  prev=""
  for arg in "$@"; do
    # --method/-X takes a value three ways: split ("-X" "PUT"), joined with
    # "=" ("--method=PUT"), or glued to the short flag ("-XPUT") — pflag
    # (gh's flag parser) accepts all three, so all three must be recognized
    # here or one of them silently walks past the deny check below. --input
    # has no glued short form (gh defines no short flag for it), so only
    # split and joined need recognizing.
    case "$prev" in
      -X | --method)
        method="$arg"
        ;;
      --input)
        input_value="$arg"
        ;;
    esac
    case "$arg" in
      --method=*)
        method="${arg#--method=}"
        ;;
      -X?*)
        method="${arg#-X}"
        ;;
      --input=*)
        input_value="${arg#--input=}"
        ;;
    esac
    case "$arg" in
      */merge)
        [ -z "$path" ] && path="$arg"
        ;;
    esac
    case "$arg" in
      *state=closed* | *'"state":"closed"'* | *'"state": "closed"'*)
        body_has_closed=1
        ;;
    esac
    prev="$arg"
  done
  method=$(printf '%s' "$method" | tr '[:lower:]' '[:upper:]')

  # --input replaces the whole request body from a file or stdin (per `gh api
  # --help`), which the argv scan above never sees — a state:closed body
  # delivered this way must be inspected from its actual source instead.
  if [ -n "$input_value" ] && [ "$body_has_closed" != "1" ]; then
    if [ "$input_value" = "-" ]; then
      # Stdin is a single-read stream: buffer it to a temp file so it can be
      # inspected here and still replayed to the real gh below — reading it
      # once with no buffer would leave the real call with an already-drained
      # stdin.
      stdin_capture=$(mktemp "${TMPDIR:-/tmp}/gh-guard-stdin.XXXXXX")
      cat > "$stdin_capture"
      grep -q -e 'state=closed' -e '"state":"closed"' -e '"state": "closed"' "$stdin_capture" \
        && body_has_closed=1
    elif [ -r "$input_value" ]; then
      grep -q -e 'state=closed' -e '"state":"closed"' -e '"state": "closed"' "$input_value" \
        && body_has_closed=1
    fi
  fi

  if [ "$method" = "PUT" ] && [ -n "$path" ]; then
    deny
  fi
  if [ "$method" = "PATCH" ] && [ "$body_has_closed" = "1" ]; then
    deny
  fi
fi

if [ -n "$stdin_capture" ]; then
  # Open the buffered body on a separate fd, then unlink it immediately: the
  # inode stays reachable through that fd across exec (so the real gh still
  # reads the full body on its stdin), but no temp file survives on disk once
  # the replaced process closes it — exec never runs this script's own EXIT
  # trap, so without this the file would otherwise leak on every guarded
  # `--input -` call.
  exec 3< "$stdin_capture"
  rm -f "$stdin_capture"
  exec "$GH_GUARD_REAL_GH" "$@" <&3
fi

exec "$GH_GUARD_REAL_GH" "$@"
