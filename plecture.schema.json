          "type": "string"
        }
      }
    },
    "configFile": {
      "$comment": "PLECTURE-CFG-FIELD-UNKNOWN: a reserved root file's surface is closed, and a definition table is not part of it.",
      "$anchor": "config",
      "type": "object",
      "additionalProperties": false,
      "description": "config.toml, a reserved root file. It is not a definition file.",
      "properties": {
        "workspace_dirs_root": {
          "type": "string"
        },
        "resource_allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "plugin_dirs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "detached": {
          "type": "boolean"
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/staticReference"
          }
        },
        "inputs_schema": {
          "$ref": "#/$defs/schemaDocument"
        },
        "inputs_schema_file": {
          "type": "string"
        }
      }
    },
    "catalogsFile": {
      "$anchor": "catalogs",
      "type": "object",
      "additionalProperties": false,
      "description": "catalogs.toml, a reserved root file: the catalog aliases registered on this machine and the plugins enabled under each.",
      "required": [
        "schema_version"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "catalogs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "alias",
              "source"
            ],
            "properties": {
              "alias": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "source": {
                "type": "string"
              },
              "subdir": {
                "type": "string"
              },
              "plugins": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "lockFile": {
      "$anchor": "lock",
      "type": "object",
      "additionalProperties": false,
      "description": "plect.lock, a reserved root file: the resolved revisions and content hashes mounting is verified against.",
      "required": [
        "schema_version"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "catalogs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
