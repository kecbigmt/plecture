              },
              "catalog_alias": {
                "type": "string"
              },
              "catalog_source": {
                "type": "string"
              },
              "catalog_resolved_revision": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "content_hash": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "plect_min_version": {
