    "pluginManifest": {
      "$comment": "PLECTURE-CFG-FIELD-REQUIRED, PLECTURE-CFG-FIELD-UNKNOWN.",
      "$anchor": "plugin",
      "type": "object",
      "additionalProperties": false,
      "description": "plugin.toml at a plugin's root: the package's identity, its executables, and the services the resident process supervises.",
      "required": [
        "schema_version",
        "version",
        "plect_min_version",
        "description"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
