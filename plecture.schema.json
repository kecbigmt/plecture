    "taskOutputsTable": {
      "$comment": "PLECTURE-CFG-FIELD-TYPE, PLECTURE-CFG-FIELD-UNKNOWN.",
      "type": "object",
      "additionalProperties": false,
      "description": "A task's public output wiring. Its roots are the nesting joint's: an inner output or this layer's locals. A live root belongs to a work document's completion predicate, so re-evaluation is not a task concern.",
      "properties": {
        "bind": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/taskOutputValue"
          }
        }
      }
    },
    "taskOutputValue": {
      "$comment": "PLECTURE-CFG-FROM-ROOT: a task output projects inner.outputs.* or locals.* only.",
      "type": "object",
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/fromValue"
            },
            {
              "properties": {
                "from": {
                  "pattern": "^(inner\\.outputs|locals)\\."
                }
              }
            }
          ]
        },
        {
          "$ref": "#/$defs/exprValue"
        }
      ]
    },
    "workDefinition": {
      "$comment": "PLECTURE-CFG-FIELD-UNKNOWN, PLECTURE-CFG-FIELD-REQUIRED, PLECTURE-CFG-KIND-MISSING.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "resource_observer"
      ],
      "description": "A work declaration. It is an ordinary definition block, declared the same way every other kind is; what makes it a work document is that it is the single block in a Markdown file's TOML frontmatter, and that file's body is this declaration's instruction. A document is authored and referenced by its id; an instance is created from it by dynamic instantiation and identified by its resource and instance name.",
      "properties": {
        "kind": {
          "const": "work"
        },
        "description": {
          "type": "string"
        },
        "resource_observer": {
          "$ref": "#/$defs/staticReference",
          "description": "The resource observer this work is written for. Named after the kind it references, the same way a workflow's workspace_provider field is. Declaring it is what lets every key a check or a chain input reads be resolved against that observer's published state at load time, and what lets instantiation reject an incompatible resource up front."
        },
        "inputs_schema": {
          "$ref": "#/$defs/schemaDocument",
          "description": "The instruction's author-declared parameters."
        },
        "inputs_schema_file": {
          "type": "string"
        },
        "state_schema": {
          "$ref": "#/$defs/schemaDocument",
          "description": "This work's own state: the keys a reviewer or another session writes into an instance. Plain JSON Schema, with no mutability annotation \u2014 state is mutable by definition. Any state-holding definition declares its state this way."
        },
        "state_schema_file": {
          "type": "string"
        },
        "done_when": {
          "$ref": "#/$defs/doneWhen"
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "heartbeat_budget": {
              "type": "integer",
              "minimum": 1
            },
            "on_exhaust": {
              "enum": [
                "escalate",
                "stop"
              ]
            }
          }
        },
        "chains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chainDefinition"
          }
        }
      }
    },
    "workFrontmatter": {
      "$anchor": "work",
      "$comment": "PLECTURE-CFG-WORK-BLOCK-COUNT: a work document's frontmatter holds exactly one declaration.",
      "type": "object",
      "description": "The TOML frontmatter of a work document: one definition block, whose kind is work. Nothing about the grammar forks \u2014 these are two validation rules over the ordinary definition document.",
      "minProperties": 1,
      "maxProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/workDefinition"
      }
    },
    "completionKeyPath": {
      "$comment": "PLECTURE-CFG-FROM-ROOT: a completion key reads resource.state.* or self.state.*.",
      "type": "string",
      "pattern": "^(resource\\.state|self\\.state)\\.[A-Za-z_][A-Za-z0-9_]*$"
    },
    "exprLeaf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expr"
      ],
      "description": "A predicate computed over the roots this surface observes.",
      "properties": {
        "expr": {
          "type": "string"
        }
      }
    }
  }
}
