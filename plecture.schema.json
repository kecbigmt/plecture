        "cleanup": {
          "$ref": "#/$defs/action"
        },
        "subscribe": {
          "$ref": "#/$defs/action"
        },
        "inputs_schema": {
          "$ref": "#/$defs/schemaDocument"
        },
        "inputs_schema_file": {
          "type": "string"
