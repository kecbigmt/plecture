{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kecbigmt/plecture/plecture.schema.json",
  "title": "Plecture configuration language",
  "description": "Structural schema for Plecture configuration. The root schema describes a definition document: a TOML file whose top-level tables are definition blocks. A work document is a Markdown file whose TOML frontmatter is validated at #work. The reserved root files and the plugin/catalog manifests have their own entry points too, so the full set of anchors is #definitions, #work, #config, #catalogs, #lock, #plugin, and #catalog. This schema is authoritative for accepted structural shapes until the implementation lands a schema generator whose output is conformance-tested against it. It deliberately does not encode cross-definition or evaluation-context rules, which are Plecture semantic validation, nor expression correctness, which is CEL validation.",
  "$ref": "#/$defs/definitionDocument",
  "$defs": {
    "definitionDocument": {
      "$anchor": "definitions",
      "type": "object",
      "description": "A discovered TOML file in a trusted definition root. Every top-level table is a definition block whose table name is the definition id.",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
        "$comment": "PLECTURE-CFG-ID-INVALID. Dots separate address segments and hyphens are excluded because a task id is also a workflow node id."
      },
      "additionalProperties": {
        "$ref": "#/$defs/definition"
      }
    },
    "definition": {
      "type": "object",
      "required": [
        "kind"
      ],
      "$comment": "PLECTURE-CFG-KIND-MISSING when kind is absent; PLECTURE-CFG-KIND-UNKNOWN when it is outside the vocabulary; PLECTURE-CFG-WORK-IN-TOML-DOCUMENT when a kind whose declaration needs a body appears in a TOML definition document.",
      "properties": {
        "kind": {
          "enum": [
            "task",
            "work",
            "channel",
            "workflow",
            "workspace_provider",
            "resource_observer"
          ]
        }
      },
      "oneOf": [
        {
          "$ref": "#/$defs/taskDefinition"
        },
        {
          "$ref": "#/$defs/channelDefinition"
        },
        {
          "$ref": "#/$defs/workflowDefinition"
        },
        {
          "$ref": "#/$defs/workspaceProviderDefinition"
        },
        {
          "$ref": "#/$defs/resourceObserverDefinition"
        }
      ],
      "description": "A definition block in a TOML definition document. Every kind is declared the same way \u2014 a table named by the definition id, carrying kind \u2014 but a kind with a body, which today means work, is declared in a Markdown file's frontmatter instead and is validated at #work.",
      "not": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "work"
          }
        }
      }
    },
    "staticReference": {
      "type": "string",
      "description": "A dotted definition address: the relative form <id>, or the catalog-qualified form <catalog-alias>.<plugin-path>.<id>. Never a tagged value, because static topology stays statically discoverable.",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z0-9][A-Za-z0-9_-]*)*$",
      "$comment": "PLECTURE-CFG-REF-DYNAMIC when a tagged value appears here."
    },
    "executableName": {
      "type": "string",
      "description": "A plugin-owned executable. A bare name resolves against the containing plugin's own executables. User-authored config uses the catalog-qualified slash form <catalog-alias>/<plugin-path> or <catalog-alias>/<plugin-path>/<executable-name>. Executable lookup is a separate namespace from definition references and keeps the slash grammar, because it must split an arbitrary-depth plugin path from an executable name.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]*$"
    },
    "literalScalar": {
      "$comment": "PLECTURE-CFG-VALUE-TAG-SURFACE: a surface accepting a literal only rejects any tagged value.",
      "type": [
        "string",
        "number",
        "integer",
        "boolean"
      ]
    },
    "fromValue": {
      "$comment": "PLECTURE-CFG-VALUE-FROM-AND-EXPR, PLECTURE-CFG-VALUE-TAG-UNKNOWN, PLECTURE-CFG-VALUE-DEFAULT-AND-OPTIONAL.",
      "type": "object",
      "required": [
        "from"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "description": "A projection path. Its leading segment is the root; which roots are available is surface-specific and checked by Plecture semantic validation.",
          "pattern": "^[a-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$"
        },
        "default": {
          "description": "The value used when the source is absent. Mutually exclusive with optional."
        },
        "optional": {
          "const": true,
          "description": "Absence propagates: a missing source omits the key rather than supplying a sentinel. Mutually exclusive with default."
        }
      },
      "not": {
        "required": [
          "default",
          "optional"
        ],
        "$comment": "PLECTURE-CFG-VALUE-DEFAULT-AND-OPTIONAL."
      }
    },
    "exprValue": {
      "$comment": "PLECTURE-CFG-VALUE-TAG-UNKNOWN.",
      "type": "object",
      "required": [
        "expr"
      ],
      "additionalProperties": false,
      "properties": {
        "expr": {
          "type": "string",
          "description": "One CEL expression, parsed and checked against the environment declared for this expression site."
        }
      }
    },
    "terminalValue": {
      "$comment": "PLECTURE-CFG-VALUE-TAG-UNKNOWN.",
      "type": "object",
      "required": [
        "terminal"
      ],
      "additionalProperties": false,
      "properties": {
        "terminal": {
          "enum": [
            "attach",
            "capture",
            "send_text",
            "send_keys"
          ],
          "description": "A terminal capability, resolved through whichever task in the plan declares the interactive endpoint."
        }
      }
    },
    "binValue": {
      "$comment": "PLECTURE-CFG-VALUE-TAG-UNKNOWN.",
      "type": "object",
      "required": [
        "bin"
      ],
      "additionalProperties": false,
      "properties": {
        "bin": {
          "$ref": "#/$defs/executableName"
        }
      }
    },
    "jsonValue": {
      "$comment": "PLECTURE-CFG-VALUE-TAG-UNKNOWN.",
      "type": "object",
      "required": [
        "json"
      ],
      "additionalProperties": false,
      "properties": {
        "json": {
          "description": "A boundary serializer, not a CEL function. Its operand is a value tree whose leaves are literals or tagged values.",
          "$ref": "#/$defs/jsonOperand"
        }
      }
    },
    "jsonOperand": {
      "anyOf": [
        {
          "$ref": "#/$defs/fromValue"
        },
        {
          "$ref": "#/$defs/exprValue"
        },
        {
          "$ref": "#/$defs/literalScalar"
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonOperand"
          }
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonOperand"
          }
        }
      ]
    },
    "taggedValue": {
      "description": "The complete tagged-value vocabulary. An object under a dynamic-value field that matches none of these forms is a structural error.",
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/fromValue"
        },
        {
          "$ref": "#/$defs/exprValue"
        },
        {
          "$ref": "#/$defs/terminalValue"
        },
        {
          "$ref": "#/$defs/binValue"
        },
        {
          "$ref": "#/$defs/jsonValue"
        }
      ],
      "$comment": "PLECTURE-CFG-VALUE-FROM-AND-EXPR, PLECTURE-CFG-VALUE-TAG-UNKNOWN."
    },
    "projectionOrComputation": {
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/fromValue"
        },
        {
          "$ref": "#/$defs/exprValue"
        }
      ]
    },
    "dataValue": {
      "description": "A value on a surface that consumes data only: a literal, a projection, a computation, or a JSON serialization. No capability tags.",
      "anyOf": [
        {
          "$ref": "#/$defs/literalScalar"
        },
        {
          "$ref": "#/$defs/fromValue"
        },
        {
          "$ref": "#/$defs/exprValue"
        },
        {
          "$ref": "#/$defs/jsonValue"
        }
      ],
      "$comment": "PLECTURE-CFG-VALUE-TAG-SURFACE when a capability tag appears here."
    },
    "bindingValue": {
      "$comment": "PLECTURE-CFG-VALUE-TAG-UNKNOWN, PLECTURE-CFG-VALUE-FROM-AND-EXPR, PLECTURE-CFG-VALUE-DEFAULT-AND-OPTIONAL.",
      "description": "A value on an action-binding surface, which may additionally consume a Plecture capability.",
      "anyOf": [
        {
          "$ref": "#/$defs/literalScalar"
        },
        {
          "$ref": "#/$defs/fromValue"
        },
        {
          "$ref": "#/$defs/exprValue"
        },
        {
          "$ref": "#/$defs/jsonValue"
        },
        {
          "$ref": "#/$defs/terminalValue"
        },
        {
          "$ref": "#/$defs/binValue"
        }
      ]
    },
    "bindTable": {
      "type": "object",
      "description": "An action binding: the values and capabilities crossing the Plecture/action boundary. Each key becomes a shell variable name.",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/bindingValue"
      }
    },
    "execAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "exec"
        },
        "bin": {
          "$ref": "#/$defs/executableName"
        },
        "command": {
          "type": "string",
          "description": "A literal OS command name or path, resolved through the process environment. Never dynamic."
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bindingValue"
          }
        },
        "stdin": {
          "$ref": "#/$defs/bindingValue",
          "description": "A value written to the process's standard input instead of its argv, for data that must not be visible in the process table."
        }
      },
      "oneOf": [
        {
          "required": [
            "bin"
          ],
          "not": {
            "required": [
              "command"
            ]
          }
        },
        {
          "required": [
            "command"
          ],
          "not": {
            "required": [
              "bin"
            ]
          }
        }
      ],
      "$comment": "PLECTURE-CFG-ACTION-BIN-AND-COMMAND when both are set or neither is."
    },
    "shellAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "script"
      ],
      "properties": {
        "type": {
          "const": "shell"
        },
        "script": {
          "$comment": "PLECTURE-CFG-SHELL-INTERPOLATION.",
          "type": "string",
          "description": "Literal shell source. Plecture and CEL interpolation do not occur inside it.",
          "not": {
            "pattern": "\\{\\{"
          }
        },
        "bind": {
          "$ref": "#/$defs/bindTable"
        }
      }
    },
    "action": {
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/execAction"
        },
        {
          "$ref": "#/$defs/shellAction"
        }
      ],
      "$comment": "PLECTURE-CFG-ACTION-TYPE-UNKNOWN for an unknown type; PLECTURE-CFG-ACTION-VARIANT when a field of the other variant is present."
    },
    "schemaDocument": {
      "type": "object",
      "description": "A JSON Schema document, inline in TOML. Plecture annotations such as mutable may extend it. Plecture tagged values may not appear in it.",
      "properties": {
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/schemaPropertySpec"
          }
        },
        "items": {
          "$ref": "#/$defs/schemaPropertySpec"
        }
      }
    },
    "schemaPropertySpec": {
      "allOf": [
        {
          "$ref": "#/$defs/schemaDocument"
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "from"
                ]
              },
              {
                "required": [
                  "expr"
                ]
              },
              {
                "required": [
                  "terminal"
                ]
              },
              {
                "required": [
                  "bin"
                ]
              },
              {
                "required": [
                  "json"
                ]
              }
            ]
          },
          "$comment": "PLECTURE-CFG-VALUE-TAG-SURFACE: a contract document declares types, not values."
        }
      ]
    },
    "innerTable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uses"
      ],
      "description": "The nesting joint, read from the surface being configured: the inner task's input object and its environment additions.",
      "properties": {
        "uses": {
          "$ref": "#/$defs/staticReference"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/dataValue"
          }
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/dataValue"
          }
        }
      }
    },
    "healthTable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alive": {
          "$ref": "#/$defs/action"
        },
        "activity": {
          "$ref": "#/$defs/action"
        }
      }
    },
    "terminalTable": {
      "type": "object",
      "additionalProperties": false,
      "description": "The task owns an interactive endpoint. send_text and send_keys receive their operand as the action's first positional argument.",
      "properties": {
        "attach": {
          "$ref": "#/$defs/action"
        },
        "capture": {
          "$ref": "#/$defs/action"
        },
        "send_text": {
          "$ref": "#/$defs/action"
        },
        "send_keys": {
          "$ref": "#/$defs/action"
        }
      }
    },
    "checkLeaf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check"
      ],
      "properties": {
        "check": {
          "$ref": "#/$defs/completionKeyPath"
        },
        "eq": {},
        "ne": {},
        "in": {
          "type": "array"
        },
        "gte": {
          "type": "number"
        },
        "lte": {
          "type": "number"
        }
      }
    },
    "judgeLeaf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "judge",
        "id"
      ],
      "properties": {
        "judge": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "relation": {
          "type": "array",
          "items": {
            "enum": [
              "sibling",
              "parent",
              "child"
            ]
          }
        }
      }
    },
    "doneWhen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all"
      ],
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "oneOf": [
              {
                "$ref": "#/$defs/checkLeaf"
              },
              {
                "$ref": "#/$defs/exprLeaf"
              },
              {
                "$ref": "#/$defs/judgeLeaf"
              }
            ]
          }
        }
      }
    },
    "chainWhenFact": {
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/checkLeaf"
        },
        {
          "$ref": "#/$defs/exprLeaf"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "judge_pending"
          ],
          "properties": {
            "judge_pending": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "judge_action",
            "is"
          ],
          "properties": {
            "judge_action": {
              "type": "string"
            },
            "is": {
              "type": "string"
            }
          }
        }
      ]
    },
    "chainDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "workflow",
        "when"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "workflow": {
          "$ref": "#/$defs/staticReference"
        },
        "placement": {
          "enum": [
            "sibling",
            "child"
          ]
        },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/chainWhenFact"
              }
            }
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/dataValue"
          }
        }
      },
      "description": "A chain fires against instances of the work document that declared it."
    },
    "taskDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "description": "A task is a lifecycle-managed provider: contracts, health, an optional interactive capability, and composition. Its outputs are production records \u2014 immutable facts from setup plus nested projections. No completion contract and no live re-evaluation live here; both belong to the work document.",
      "properties": {
        "kind": {
          "const": "task"
        },
        "scope": {
          "enum": [
            "session",
            "run"
          ]
        },
        "setup": {
          "$ref": "#/$defs/action"
        },
        "cleanup": {
          "$ref": "#/$defs/action"
        },
        "inner": {
          "$ref": "#/$defs/innerTable"
        },
        "locals_schema": {
          "$ref": "#/$defs/schemaDocument"
        },
        "locals_schema_file": {
          "type": "string"
        },
        "outputs": {
          "$ref": "#/$defs/taskOutputsTable"
        },
        "inputs_schema": {
          "$ref": "#/$defs/schemaDocument"
        },
        "inputs_schema_file": {
          "type": "string"
        },
        "outputs_schema": {
          "$ref": "#/$defs/schemaDocument"
        },
        "outputs_schema_file": {
          "type": "string"
        },
        "health": {
          "$ref": "#/$defs/healthTable"
        },
        "terminal": {
          "$ref": "#/$defs/terminalTable",
          "description": "The task owns an interactive endpoint. At most one task in a plan declares it."
        }
      },
      "$comment": "PLECTURE-CFG-FIELD-UNKNOWN: the task grammar is closed, and the completion contract is not in it."
    },
    "workflowDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "workflow"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "workspace_provider": {
          "$ref": "#/$defs/staticReference"
        },
        "workspace_provider_inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/literalScalar"
          },
          "description": "Literal data only: a workspace provider's hooks run before any node output exists."
        },
        "display": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/dataValue"
          }
        },
        "auto_select": {
          "type": "boolean"
        },
        "inputs_schema": {
          "$ref": "#/$defs/schemaDocument"
        },
        "inputs_schema_file": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "uses"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "uses": {
                "$ref": "#/$defs/staticReference"
              },
              "inputs": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/dataValue"
                }
              },
              "blocks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                }
              }
            }
          }
        },
        "event": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "channel": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "uses"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "uses": {
                    "$ref": "#/$defs/staticReference"
                  },
                  "inputs": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/$defs/dataValue"
                    }
                  },
                  "include": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "tick": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "on": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "heartbeat": {
              "type": "string"
            },
            "max_heartbeat": {
              "type": "string"
            }
          }
        },
        "healthcheck": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "period": {
              "type": "string"
            },
            "stall_threshold": {
              "type": "string"
            },
            "renotify_every": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "channelInputSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "description": "A channel's per-key parameter shorthand, deliberately not a full JSON Schema document: only a channel input's presence is checked before delivery.",
      "properties": {
        "type": {
          "const": "string"
        },
        "required": {
          "type": "boolean"
        },
        "default": {
          "type": "string"
        }
      }
    },
    "channelDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "type"
      ],
      "properties": {
        "kind": {
          "const": "channel"
        },
        "type": {
          "enum": [
            "unix_socket",
            "exec",
            "shell"
          ]
        },
        "input_schema": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/channelInputSpec"
          }
        },
        "timeout": {
          "description": "A delivery deadline, bounding one attempt. It reads author-declared parameters only; event data is excluded, so a delivery's own deadline can never be chosen by the event being delivered.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "allOf": [
                {
                  "$ref": "#/$defs/fromValue"
                },
                {
                  "properties": {
                    "from": {
                      "pattern": "^inputs\\."
                    }
                  }
                }
              ]
            }
          ],
          "$comment": "PLECTURE-CFG-CHANNEL-TIMEOUT-ROOT."
        },
        "path": {
          "$ref": "#/$defs/dataValue"
        },
        "body": {
          "$ref": "#/$defs/dataValue"
        },
        "bin": {
          "$ref": "#/$defs/executableName"
        },
        "command": {
          "$comment": "PLECTURE-CFG-REF-DYNAMIC: a channel's command is never chosen by data.",
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bindingValue"
          }
        },
        "stdin": {
          "$ref": "#/$defs/bindingValue"
        },
        "script": {
          "$comment": "PLECTURE-CFG-SHELL-INTERPOLATION.",
          "type": "string",
          "not": {
            "pattern": "\\{\\{"
          }
        },
        "bind": {
          "$ref": "#/$defs/bindTable"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "unix_socket"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$comment": "PLECTURE-CFG-ACTION-VARIANT, PLECTURE-CFG-FIELD-REQUIRED.",
            "required": [
              "path",
              "body"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "bin"
                  ]
                },
                {
                  "required": [
                    "command"
                  ]
                },
                {
                  "required": [
                    "args"
                  ]
                },
                {
                  "required": [
                    "script"
                  ]
                },
                {
                  "required": [
                    "bind"
                  ]
                },
                {
                  "required": [
                    "stdin"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "exec"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$comment": "PLECTURE-CFG-ACTION-BIN-AND-COMMAND, PLECTURE-CFG-ACTION-VARIANT.",
            "oneOf": [
              {
                "required": [
                  "bin"
                ],
                "not": {
                  "required": [
                    "command"
                  ]
                }
              },
              {
                "required": [
                  "command"
                ],
                "not": {
                  "required": [
                    "bin"
                  ]
                }
              }
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "path"
                  ]
                },
                {
                  "required": [
                    "body"
                  ]
                },
                {
                  "required": [
                    "script"
                  ]
                },
                {
                  "required": [
                    "bind"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "shell"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$comment": "PLECTURE-CFG-ACTION-VARIANT, PLECTURE-CFG-FIELD-REQUIRED.",
            "required": [
              "script"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "path"
                  ]
                },
                {
                  "required": [
                    "body"
                  ]
                },
                {
                  "required": [
                    "bin"
                  ]
                },
                {
                  "required": [
                    "command"
                  ]
                },
                {
                  "required": [
                    "args"
                  ]
                },
                {
                  "required": [
                    "stdin"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "workspaceProviderDefinition": {
      "type": "object",
